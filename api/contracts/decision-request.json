{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correlation_id",
    "device_id",
    "service_id",
    "action"
  ],
  "properties": {
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    }
  }
}
