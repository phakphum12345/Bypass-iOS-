    },
    {
      "id": 7,
      "name": "ui-boundary",
      "type": "implementation",
      "contract": "docs/architecture/PHASE_7_CONTRACT.md",
      "depends_on": [6],
      "allowed_paths": [
        "flutter_app/lib/",
        "flutter_app/test/",
        "docs/architecture/"
      ],
      "gates": [
        "dart_format",
        "flutter_analyze",
        "flutter_test",
        "contract_validation",
        "git_diff_check"
      ],
      "max_retries": 3
    },
    {
      "id": 8,
      "name": "documentation-consistency",
      "type": "documentation",
